---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
           <nav class="flex items-center gap-6 px-6 py-4 border-b bg-slate-900 text-white">
      <a href="/" class="font-semibold hover:text-sky-400">Accueil</a>
      <select id="species" class="rounded px-2 py-1 text-slate-900">
        <option value="">Toutes les espèces</option>
        <option value="Adelie">Adelie</option>
        <option value="Chinstrap">Chinstrap</option>
        <option value="Gentoo">Gentoo</option>
      </select>
      <a href="/slider/" class="hover:text-sky-400">Slider</a>
      <a href="/tabs/" class="hover:text-sky-400">Onglets</a>
    </nav>
    <slot />

    <script>
      document.querySelector("#species")?.addEventListener("change", (evt) => {
        const value = (evt.target as HTMLSelectElement).value;
        location.pathname = value ? "/species/" + value + "/" : "/";
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
