---
import Layout from "../layouts/Layout.astro";
import GraphicSpecies from "../components/GraphicSpecies.astro";

const speciesList = ["Adelie", "Chinstrap", "Gentoo"];
---

<Layout>
  <div class="p-4">
    <label for="species-anchor" class="block mb-1 font-medium">
      Défiler le slider :
    </label>
    <select id="species-anchor" class="mb-4">
      {speciesList.map((s) => <option value={s}>{s}</option>)}
    </select>

    <div class="slider">
      {speciesList.map((s) => (
        <section id={s} class="slide">
          <GraphicSpecies species={s} />
        </section>
      ))}
    </div>
  </div>

  <script>
    const select = document.querySelector<HTMLSelectElement>("#species-anchor");

    select?.addEventListener("change", (evt) => {
      const value = (evt.target as HTMLSelectElement).value;
      location.hash = value;
    });

    // Synchronise le select avec le hash actuel au chargement
    const current = location.hash.replace("#", "");
    if (select && current) {
      select.value = current;
    }
  </script>
</Layout>

<style>
  .slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    width: 100%;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
</style>